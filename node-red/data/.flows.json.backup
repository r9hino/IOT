        "type": "postgresql",
        "z": "c19fc8a18bff1dd0",
        "name": "Update Registro",
        "query": "UPDATE registros_remotos_hora\n    SET estado_dga = '{{{ msg.payload.estado_dga }}}',\n        comprobante_dga = '{{{ msg.payload.data.numeroComprobante }}}',\n        fecha_actualizacion = NOW()\n    WHERE bucket = '{{{ msg.id_composite.timestamp_no_ms }}}'\n    AND id_obra = 1;",
