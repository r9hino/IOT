    {
        "id": "aca9796f6ef0f4e6",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Calculo Caudal",
        "func": "/* \nRecibe señales de sensores de 4-20mA convertidas a\nvoltaje por medio de tarjeta.\nAI0 deberia ir sensor aforador, AI1 sensor rio.\n*/\n\nlet v_nivel_aforador = msg.payload.A0.voltage;\nlet v_nivel_rio = msg.payload.A1.voltage;\nlet h_nivel_aforador;\nlet h_nivel_rio;\nlet Q;\nmsg.sensors_status = '';\n\n// Si la corriente es menor a 4mA o voltaje leido en sensor de aforador es \n// menor a 0.6V (4mA * 150Ohm) hay un problema en el sensor, alimentacion de sensor,\n// cable, terminales o tarjeta conversora de corriente a voltaje.\n// Sensor 4mA -> 0.6V -> 0m         20mA -> 3.0V -> 2m\n\n// Medicion AI0 con error\nif (v_nivel_aforador < 0.5) {\n  msg.sensors_status = \"AI0 error\";\n  //msg.payload = \"Señal en AI0 no detectada, posible problema con sensor, conexion o tarjeta interfaz.\";\n}\n// Medicion AI0 ok\nelse{\n  msg.sensors_status = \"AI0 ok\";\n\n  // Calcular profundidad nivel rio segun voltajes\n  h_nivel_aforador = (2 - 0.0) / (3 - 0.6) * (v_nivel_aforador - 0.6) + 0.0;\n  if (h_nivel_aforador < 0) h_nivel_aforador = 0;\n\n  // Caudal canal segun curva carga\n  Q = -0.06618 + 1.02186 * h_nivel_aforador + 1.3391 * h_nivel_aforador * h_nivel_aforador;\n  if (Q < 0) Q = 0;\n}\n\n// Medicion AI1 con error\nif (v_nivel_rio < 0.5) {\n  if(msg.sensors_status == 'AI0 ok') msg.sensors_status = \"AI0 ok - AI1 error\";\n  else if(msg.sensors_status == 'AI0 error') msg.sensors_status = \"AI0 error - AI1 error\";\n  //msg.payload = \"Señal en AI1 no detectada, posible problema con sensor, conexion o tarjeta interfaz.\";\n}\n// Medicion AI2 ok\nelse{\n  if(msg.sensors_status == 'AI0 ok') msg.sensors_status = \"AI0 ok - AI1 ok\";\n  else if (msg.sensors_status == \"AI0 error\") msg.sensors_status = \"AI0 error - AI1 ok\";\n\n  // Calcular profundidad nivel rio segun voltajes\n  h_nivel_rio = (2 - 0.0) / (3 - 0.6) * (v_nivel_rio - 0.6) + 0.0;\n  if (h_nivel_rio < 0) h_nivel_rio = 0;\n}\n\n\nmsg.payload = {\n  v_nivel_aforador: v_nivel_aforador,\n  h_nivel_aforador: h_nivel_aforador,\n  caudal: Q,\n  v_nivel_rio: v_nivel_rio,\n  h_nivel_rio: h_nivel_rio\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 300,
        "wires": [
            [
                "893673ea93e0e06f",
                "cb9939cec12d3f14"
            ]
        ]
    },
    {
        "id": "cc9d55b43af50ae2",
        "type": "postgresql",
        "z": "f6f2187d.f17ca8",
        "name": "Insertar registro",
        "query": "INSERT INTO registros (fecha_hora,\n    id_obra,\n    nivel_aforador,\n    nivel_limnimetrico,\n    caudal)\n    VALUES (NOW(), \n    1,\n    {{{ msg.payload.h_nivel_aforador }}},\n    {{{ msg.payload.h_nivel_rio }}},\n    {{{ msg.payload.caudal }}});",
        "postgreSQLConfig": "b23d8359c5c9ebfb",
        "split": false,
        "rowsPerMsg": 1,
        "outputs": 1,
        "x": 580,
        "y": 360,
        "wires": [
            []
        ]
    },
