    {
        "id": "356fa6003b59a4df",
        "type": "debug",
        "z": "c19fc8a18bff1dd0",
        "name": "Respuesta server DGA",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "true",
        "targetType": "full",
        "statusVal": "",
        "statusType": "auto",
        "x": 390,
