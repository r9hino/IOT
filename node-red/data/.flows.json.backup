    {
        "id": "540226749f1012f8",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Calculo Nivel",
        "func": "let caudal_m3s = msg.payload.pehui.caudal_total_m3s || null;\nlet caudal_m3s_noise;\nlet sensor_status = msg.payload.ads2_AI1.sensor_status;\nlet h_nivel_aforador_cm;\n\n// Convertir caudal en nivel\n// Ecuacion de caudal canal segun curva carga Ernesto Gesche\n// Q = -0.06618 + 1.02186 * h_nivel_aforador + 1.4491 * h_nivel_aforador * h_nivel_aforador;\n// Formula cuadratica para obtener nivel aforador a partir del caudal.\n// Se elimina coeficiente c de ecuacion: Q = a*h^2 + b*h + c\nif(sensor_status === 'Ok'){\n  caudal_m3s_noise = caudal_m3s + (Math.random() - 0.5)*0.04;\n  h_nivel_aforador_cm = 100*(0.09261 + 0.54499*caudal_m3s_noise - 0.06919*caudal_m3s_noise*caudal_m3s_noise);\n}\n\nmsg.payload = {\n  h_nivel_aforador_cm: h_nivel_aforador_cm,\n  caudal_m3s: caudal_m3s,\n  caudal_m3s_noise: caudal_m3s_noise\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 880,
