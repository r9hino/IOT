        "type": "postgresql",
        "z": "c19fc8a18bff1dd0",
        "name": "Query registros pendientes",
        "query": "select count(*) AS registros_pendientes\nfrom registros_hora\nwhere \"estado_dga\" <> 'Enviado ok'\nand id_obra = {{{ msg.id_composite.id_obra }}};",
