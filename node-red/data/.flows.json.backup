    {
        "id": "aca9796f6ef0f4e6",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Calculo Caudal",
        "func": "let v_nivel_aforador = msg.payload.A0.voltage;\nlet v_nivel_rio = msg.payload.A1.voltage;\n\n// Convertir voltaje a profundidad\n// Sensor aforado - Ver excel Monitoreo Caudal DGA Bocatoma Don Walterio\n//let h_nivel_aforador = (0.75 - 0.3) / (1.19 - 0.872) * (v_nivel_aforador - 0.872) + 0.3;\nlet h_nivel_aforador = 0.69 / (1.112 - 0.6) * (v_nivel_aforador - 1.112) + 0.69;\nif (h_nivel_aforador < 0) h_nivel_aforador = 0;\n\n// Caudal canal segun curva carga Ernesto Gesche\nlet Q = -0.04977 + 1.75132 * h_nivel_aforador + 3.99181 * h_nivel_aforador * h_nivel_aforador;\nif (Q < 0) Q = 0;\n\n// Calcular profundidad nivel rio.\n// Sensor 4mA -> 0.6V -> 0m         20mA -> 3.0V -> 3m\nlet h_nivel_rio = (3 - 0.0) / (3 - 0.6) * (v_nivel_rio - 0.6) + 0;\nif (h_nivel_rio < 0) h_nivel_rio = 0;\n\nmsg.payload = {\n  v_nivel_aforador: v_nivel_aforador,\n  h_nivel_aforador: h_nivel_aforador,\n  caudal: Q,\n  v_nivel_rio: v_nivel_rio,\n  h_nivel_rio: h_nivel_rio\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 300,
        "wires": [
            [
                "cc9d55b43af50ae2",
                "893673ea93e0e06f"
            ]
        ]
    },
    {
        "id": "cc9d55b43af50ae2",
        "type": "postgresql",
        "z": "f6f2187d.f17ca8",
        "name": "Insertar registro",
        "query": "INSERT INTO registros (fecha_hora,\n    id_obra,\n    nivel_aforador,\n    nivel_limnimetrico,\n    caudal)\n    VALUES (NOW(), \n    1,\n    {{{ msg.payload.h_nivel_aforador }}},\n    {{{ msg.payload.h_nivel_rio }}},\n    {{{ msg.payload.caudal }}});",
        "postgreSQLConfig": "b23d8359c5c9ebfb",
        "split": false,
        "rowsPerMsg": 1,
        "outputs": 1,
        "x": 560,
        "y": 340,
        "wires": [
            []
        ]
    },
