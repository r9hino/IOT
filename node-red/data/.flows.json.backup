    {
        "id": "f60ee1f6c24b7cc7",
        "type": "mqtt out",
        "z": "f6f2187d.f17ca8",
        "name": "Send-Camara-Carga-Rhom-Data",
        "topic": "sensor/camara-carga-rhom",
        "qos": "",
        "retain": "",
        "respTopic": "",
        "contentType": "",
